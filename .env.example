# Owner-only access gate; leave empty locally to disable. Use a long passphrase in Production.
APP_ACCESS_CODE=

# Kite Connect Personal (Free) credentials — server-side only
KITE_API_KEY=
KITE_API_SECRET=
# Exact registered redirect URL, e.g. https://your-deployment.example/api/zerodha/callback
KITE_REDIRECT_URL=
# Generate a random 32-byte key and base64-encode it; do not commit real values.
KITE_SESSION_ENCRYPTION_KEY=
